@inherits LayoutComponentBase

<Toasts @rendermode="InteractiveServer"
        class="p-3"
        AutoHide="true"
        StackLength="3"
        Placement="ToastsPlacement.TopRight" />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main style="background-color: #F3EDE4; min-height: 100vh;">

        <div class="top-row px-4">
            <div class="top-acciones">
                <a href="/Carrito/Index" class="btn-top-carrito" title="Mi Carrito">
                    <i class="bi bi-bag"></i>
                    <span>Carrito</span>
                </a>
                <a href="Account/Login" class="btn-top-login" title="Iniciar Sesión">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Cerrar Sesión</span>
                </a>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
