@rendermode InteractiveServer

@inject AuthenticationStateProvider authenticationStateProvider
@inject UserManager<Usuarios> userManager
@inject IDbContextFactory<Contexto> contextFactory

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/inicio">
            Arthea
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">

    @* Logotipo *@
    <div class="text-center my-3">
        <img src="/imagenes/logo-arthea.png" alt="Logo Arthea" class="logo-arthea" />
    </div>

    @* Perfil del usuario *@
    <div class="perfil-usuario">
        <div class="marco-usuario">
            <img src="@FotoUsuario" alt="Usuario" class="foto-usuario" />
        </div>
        <h6 class="nombre-usuario">@NombreUsuario</h6>
    </div>

    <hr class="separador-arthea" />

    <nav class="nav flex-column">

        @* Inicio *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/inicio" Match="NavLinkMatch.All" @onclick="CerrarMenu">
                <span class="bi bi-house-door-fill"></span>
                Inicio
            </NavLink>
        </div>

        @* Catálogo *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/Catalogo/Index" @onclick="CerrarMenu">
                <span class="bi bi-grid-fill"></span>
                Catálogo
            </NavLink>
        </div>

        @* Gestión de Usuarios *@
        <div class="nav-item px-3">
            <button class="nav-link menu-desplegable" type="button" @onclick='() => AlternarMenu("Usuarios")' aria-expanded='@(menuAbierto == "Usuarios")'>
                <span class="bi bi-people-fill"></span>
                Gestión de Usuarios
                <span class="bi bi-chevron-down ms-auto"></span>
            </button>

            @if (menuAbierto == "Usuarios")
            {
                <div class="submenu">
                    <NavLink class="nav-link" href="/Artistas/Index" @onclick="CerrarMenu">
                        Artistas
                    </NavLink>

                    <NavLink class="nav-link" href="/Clientes/Index" @onclick="CerrarMenu">
                        Clientes
                    </NavLink>
                </div>
            }
        </div>

        @* Gestión Artística *@
        <div class="nav-item px-3">
            <button class="nav-link menu-desplegable" type="button" @onclick='() => AlternarMenu("Artistica")' aria-expanded='@(menuAbierto == "Artistica")'>
                <span class="bi bi-palette-fill"></span>
                Gestión Artística
                <span class="bi bi-chevron-down ms-auto"></span>
            </button>

            @if (menuAbierto == "Artistica")
            {
                <div class="submenu">
                    <NavLink class="nav-link" href="/Portafolios/Index" @onclick="CerrarMenu">
                        Portafolios
                    </NavLink>

                    <NavLink class="nav-link" href="/Obras/Index" @onclick="CerrarMenu">
                        Obras
                    </NavLink>

                    <NavLink class="nav-link" href="/Servicios/Index" @onclick="CerrarMenu">
                        Servicios
                    </NavLink>
                </div>
            }
        </div>

        @* Gestión Comercial *@
        <div class="nav-item px-3">
            <button class="nav-link menu-desplegable" type="button" @onclick='() => AlternarMenu("Comercial")' aria-expanded='@(menuAbierto == "Comercial")'>
                <span class="bi bi-bag-fill"></span>
                Gestión Comercial
                <span class="bi bi-chevron-down ms-auto"></span>
            </button>

            @if (menuAbierto == "Comercial")
            {
                <div class="submenu">
                    <NavLink class="nav-link" href="/Pedidos/Index" @onclick="CerrarMenu">
                        Pedidos
                    </NavLink>

                    <AuthorizeView Roles="Administrador,Artista">
                        <Authorized>
                            <NavLink class="nav-link" href="/SolicitudesPedidos/Index" @onclick="CerrarMenu">
                                Solicitudes de Pedidos
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>
                </div>
            }
        </div>

        @* Administración *@
        <div class="nav-item px-3">
            <button class="nav-link menu-desplegable" type="button" @onclick='() => AlternarMenu("Administracion")' aria-expanded='@(menuAbierto == "Administracion")'>
                <span class="bi bi-gear-fill"></span>
                Administración
                <span class="bi bi-chevron-down ms-auto"></span>
            </button>

            @if (menuAbierto == "Administracion")
            {
                <div class="submenu">
                    <NavLink class="nav-link" href="/Administradores/Index" @onclick="CerrarMenu">
                        Administradores
                    </NavLink>
                </div>
            }
        </div>

        @* Reportes *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Reportes" @onclick="CerrarMenu">
                <span class="bi bi-bar-chart-fill"></span>
                Reportes
            </NavLink>
        </div>

    </nav>
</div>

@code {
    private string? menuAbierto = null;
    private string NombreUsuario = string.Empty;
    private string FotoUsuario = "/imagenes/usuario.jpeg";

    protected override async Task OnInitializedAsync()
    {
        var estado = await authenticationStateProvider.GetAuthenticationStateAsync();

        if (estado.User.Identity?.IsAuthenticated != true)
            return;

        var usuario = await userManager.GetUserAsync(estado.User);

        if (usuario == null)
            return;

        NombreUsuario = $"{usuario.Nombres} {usuario.Apellidos}";

        await using var contexto = await contextFactory.CreateDbContextAsync();

        var foto = await contexto.Set<Administradores>().AsNoTracking().Where(a => a.UsuarioId == usuario.Id).Select(a => a.FotoPerfil).FirstOrDefaultAsync();

        foto ??= await contexto.Set<Artistas>().AsNoTracking().Where(a => a.UsuarioId == usuario.Id).Select(a => a.FotoPerfil).FirstOrDefaultAsync();

        foto ??= await contexto.Set<Clientes>().AsNoTracking().Where(c => c.UsuarioId == usuario.Id).Select(c => c.FotoPerfil).FirstOrDefaultAsync();

        if (!string.IsNullOrWhiteSpace(foto))
            FotoUsuario = foto;
    }

    private void AlternarMenu(string menu)
    {
        menuAbierto = menuAbierto == menu ? null : menu;
    }

    private void CerrarMenu()
    {
        menuAbierto = null;
    }
}
