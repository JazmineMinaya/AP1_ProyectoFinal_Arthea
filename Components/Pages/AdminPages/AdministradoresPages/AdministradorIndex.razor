@page "/Administradores/Index"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]

@inject AdministradoresService administradoresService
@inject ToastService toastService

<PageTitle>Administradores</PageTitle>

<div class="container arthea-admin-index">
    <div class="card shadow-lg">

        @* Encabezado *@
        <div class="card-header d-flex justify-content-between align-content-center">
            <h5 class="card-title">Registro de Administradores</h5>
            <a href="/Administradores/Create" class="btn btn-primary"><span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">

            @* Labels *@
            <div class="row">

                @* Filtrar por *@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @* Búsqueda *@
                <div class="col-4">
                    <label class="col-form-label"><strong>Búsqueda</strong></label>
                </div>
            </div>

            @* Filtros *@
            <div class="row align-items-end">

                @* Filtrar por *@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" disabled>Elija una opción</option>
                        <option value="AdministradorId">AdministradorId</option>
                        <option value="Nombres">Nombres</option>
                        <option value="Correo">Correo</option>
                        <option value="Fecha">Fecha</option>
                    </InputSelect>
                </div>

                @* Búsqueda *@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>

                @* Reestablecer *@
                <div class="col-2">
                    <button type="button" class="btn btn-outline-secondary bi bi-arrow-counterclockwise" @onclick="Reestablecer"></button>
                </div>

                @* Filtro Fecha *@
                <div class="row mt-3">

                    @* Desde *@
                    <div class="col-3">
                        <label class="col-form-label"><strong>Desde</strong></label>
                        <InputDate class="form-control" @bind-Value="Desde"></InputDate>
                    </div>

                    @* Hasta *@
                    <div class="col-3">
                        <label class="col-form-label"><strong>Hasta</strong></label>
                        <InputDate class="form-control" @bind-Value="Hasta"></InputDate>
                    </div>
                </div>

                @* QuickGrid *@
                <div class="grid">
                    <QuickGrid Items="ListaAdministradores.AsQueryable()" Class="table table-hover mt-3">

                        <PropertyColumn Property="a => a.AdministradorId" Title="AdministradorId" Sortable="true" />

                        <TemplateColumn Title="Nombres" Sortable="true" SortBy="GridSort<Administradores>.ByAscending(a => a.Usuario!.Nombres)">
                            @($"{context.Usuario?.Nombres} {context.Usuario?.Apellidos}")
                        </TemplateColumn>

                        <PropertyColumn Property="a => a.Usuario!.Email" Title="Correo" Sortable="true" />
                        <PropertyColumn Property="a => a.Usuario!.FechaRegistro" Title="Fecha de Registro" Format="dd/MM/yyyy" Sortable="true" />

                        <TemplateColumn Title="Estado" Sortable="true" SortBy="GridSort<Administradores>.ByAscending(a => a.Usuario!.Estado)">
                            @(context.Usuario?.Estado == true ? "Activo" : "Inactivo")
                        </TemplateColumn>

                        <TemplateColumn Title="Opciones" Align="Align.Center">
                            <a href="/Administradores/Edit/@context.AdministradorId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                        </TemplateColumn>
                    </QuickGrid>
                </div>

            </div>
        </div>

        @* Footer *@
        <div class="card-footer d-flex justify-content-between align-items-center">
            <label><strong>Cantidad: </strong> @ListaAdministradores.Count()</label>
        </div>

    </div>
</div>

@code {
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    public List<Administradores> ListaAdministradores { get; set; } = new();

    public DateTime? Desde { get; set; }
    public DateTime? Hasta { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Reestablecer();
    }

    private async Task Buscar()
    {
        if (Filtro == "AdministradorId")
        {
            var valor = ValorFiltro.Trim();
            var resultado = await administradoresService.GetList(a => a.AdministradorId.ToString() == valor);

            ListaAdministradores = resultado.Value ?? new();
        }

        else if (Filtro == "Nombres")
        {
            var valor = ValorFiltro.Trim().ToLower();
            var resultado = await administradoresService.GetList(a => a.Usuario != null && (a.Usuario.Nombres + " " + a.Usuario.Apellidos).ToLower().Contains(valor));

            ListaAdministradores = resultado.Value ?? new();
        }

        else if (Filtro == "Correo")
        {
            var valor = ValorFiltro.Trim().ToLower();
            var resultado = await administradoresService.GetList(a => a.Usuario != null && a.Usuario.Email != null && a.Usuario.Email.ToLower().Contains(valor));

            ListaAdministradores = resultado.Value ?? new();
        }

        else if (Filtro == "Fecha")
        {
            if (Desde == null || Hasta == null)
            {
                toastService.ShowError("Seleccione las fechas Desde y Hasta");
                return;
            }

            if (Desde > Hasta)
            {
                toastService.ShowError("Seleccione un rango de fechas válido");
                return;
            }

            var desde = Desde.Value.Date;
            var hasta = Hasta.Value.Date.AddDays(1);

            var resultado = await administradoresService.GetList(a => a.Usuario != null && a.Usuario.FechaRegistro >= desde && a.Usuario.FechaRegistro < hasta);
            ListaAdministradores = resultado.Value ?? new();
        }

        else
        {
            toastService.ShowError("Seleccione un filtro");
        }
    }

    private async Task Reestablecer()
    {
        var resultado = await administradoresService.GetList(a => a.AdministradorId > 0);
        ListaAdministradores = resultado.Value ?? new();

        Filtro = string.Empty;
        ValorFiltro = string.Empty;
        Desde = null;
        Hasta = null;
    }
}
