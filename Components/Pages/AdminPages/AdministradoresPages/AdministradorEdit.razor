@page "/Administradores/Edit/{AdministradorId:int}"
@rendermode InteractiveServer

@inject AdministradoresService administradoresService
@inject NavigationManager navigationManager
@inject ToastService toastService
@inject IWebHostEnvironment environment

<PageTitle>Modificar Administrador</PageTitle>

<EditForm Model="Administrador" OnValidSubmit="Modificar" FormName="editarAdministrador" Context="formContext">
    <DataAnnotationsValidator />

    <div class="container arthea-admin-edit">
        <div class="card shadow-lg">

            <div class="card-header">
                <h5 class="card-title">Modificar Administrador</h5>
            </div>

            <div class="card-body">

                @* Foto de Perfil *@
                <div class="mb-3">
                    <label class="form-label">
                        <strong>Foto de Perfil (opcional)</strong>
                    </label>

                    <div>
                        <label for="imagen" class="cuadro-imagen">

                            @if (string.IsNullOrEmpty(imagenPreview))
                            {
                                <i class="bi bi-plus-lg"></i>
                            }
                            else
                            {
                                <img src="@imagenPreview" alt="Foto de perfil" />
                            }

                        </label>

                        <InputFile id="imagen" class="d-none" accept=".jpg,.jpeg,.png" OnChange="SeleccionarImagen" />
                    </div>
                </div>

                @* AdministradorId *@
                <div class="mb-3">
                    <label class="form-label"><strong>AdministradorId</strong></label>
                    <InputNumber class="form-control" @bind-Value="Administrador.AdministradorId" readonly />
                </div>

                @* Nombres *@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombres</strong></label>
                    <InputText class="form-control" @bind-Value="Administrador.Nombres" />
                    <ValidationMessage For="@(() => Administrador.Nombres)" />
                </div>

                @* Correo *@
                <div class="mb-3">
                    <label class="form-label"><strong>Correo</strong></label>
                    <InputText class="form-control" @bind-Value="Administrador.Correo" />
                    <ValidationMessage For="@(() => Administrador.Correo)" />
                </div>

                @* Teléfono *@
                <div class="mb-3">
                    <label class="form-label"><strong>Teléfono</strong></label>
                    <InputText class="form-control" @bind-Value="Administrador.Telefono" />
                    <ValidationMessage For="@(() => Administrador.Telefono)" />
                </div>

                @* Contraseña *@
                <div class="mb-3">
                    <label class="form-label"><strong>Contraseña (opcional)</strong></label>
                    <input type="password" class="form-control" value="@Password" @oninput="ActualizarPassword" placeholder="Dejar vacío para conservar la contraseña" />
                </div>

                @* Fecha de Registro *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Registro</strong></label>
                    <InputDate class="form-control" @bind-Value="Administrador.FechaRegistro" readonly />
                </div>

                @* Estado *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estado</strong></label>
                    <InputSelect class="form-select" @bind-Value="Administrador.Activo">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </InputSelect>
                </div>

            </div>

            @* Footer *@
            <div class="card-footer text-center mt-2">
                <a href="/Administradores/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#eliminarModal"> Eliminar</button>
            </div>

        </div>
    </div>
</EditForm>

@* Modal de eliminación *@
<div class="modal fade"
     id="eliminarModal"
     tabindex="-1"
     aria-labelledby="eliminarModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="eliminarModalLabel">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                ¿Está seguro que desea eliminar este administrador?
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cancelar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar"> Eliminar</button>
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public int AdministradorId { get; set; }

    public Administradores Administrador = new Administradores();

    public string Password { get; set; } = string.Empty;

    private IBrowserFile? imagenSeleccionada;
    private string? imagenPreview;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await administradoresService.Buscar(AdministradorId);

        if (resultado.Value is not null)
        {
            Administrador = resultado.Value;

            imagenPreview = !string.IsNullOrWhiteSpace(Administrador.FotoPerfil)
                && Administrador.FotoPerfil.StartsWith("/imagenes/administradores/") ? Administrador.FotoPerfil : null;
        }
        else
        {
            toastService.ShowError("Administrador no encontrado");
            navigationManager.NavigateTo("/Administradores/Index");
        }
    }

    private async Task Modificar()
    {
        if (await administradoresService.CorreoExiste(Administrador.Correo, Administrador.AdministradorId))
        {
            toastService.ShowError("Este correo ya está registrado");
            return;
        }

        if (!string.IsNullOrWhiteSpace(Password))
        {
            Administrador.PasswordHash =
                administradoresService.GenerarHash(Administrador, Password);
        }

        await GuardarFotografia();

        var resultado = await administradoresService.Guardar(Administrador);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Administrador modificado correctamente");
            navigationManager.NavigateTo("/Administradores/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError("No se ha podido modificar el administrador");
        });
    }

    private void ActualizarPassword(ChangeEventArgs cambio)
    {
        Password = cambio.Value?.ToString() ?? string.Empty;
    }

    private async Task SeleccionarImagen(InputFileChangeEventArgs archivoSeleccionado)
    {
        var imagen = archivoSeleccionado.File;

        var formatos = new[] { "image/jpeg", "image/png" };

        if (!formatos.Contains(imagen.ContentType.ToLowerInvariant()))
        {
            toastService.ShowError("Solo se permiten fotografías JPG, JPEG y PNG");
            return;
        }

        if (imagen.Size > 5 * 1024 * 1024)
        {
            toastService.ShowError("La fotografía no puede superar los 5 MB");
            return;
        }

        imagenSeleccionada = imagen;

        using var memoria = new MemoryStream();

        await imagen.OpenReadStream(5 * 1024 * 1024)
            .CopyToAsync(memoria);

        imagenPreview = $"data:{imagen.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}";
    }

    private async Task GuardarFotografia()
    {
        if (imagenSeleccionada is null)
            return;

        var carpeta = Path.Combine(
            environment.WebRootPath,
            "imagenes",
            "administradores"
        );

        Directory.CreateDirectory(carpeta);

        var extension = imagenSeleccionada.ContentType.ToLowerInvariant() switch
        {
            "image/jpeg" => ".jpg",
            "image/png" => ".png",
            _ => throw new InvalidOperationException("Formato no permitido")
        };

        var nombreArchivo = $"{Guid.NewGuid():N}{extension}";
        var rutaArchivo = Path.Combine(carpeta, nombreArchivo);

        await using var archivo = new FileStream(
            rutaArchivo,
            FileMode.CreateNew
        );

        await imagenSeleccionada.OpenReadStream(5 * 1024 * 1024)
            .CopyToAsync(archivo);

        Administrador.FotoPerfil =
            $"/imagenes/administradores/{nombreArchivo}";
    }

    private async Task Eliminar()
    {
        var resultado = await administradoresService.Eliminar(Administrador.AdministradorId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Administrador eliminado correctamente");
            navigationManager.NavigateTo("/Administradores/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError("No se ha podido eliminar el administrador");
        });
    }
}
