@page "/Pedidos/Create"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]

@inject PedidosService pedidosService
@inject ClientesService clientesService
@inject ServiciosService serviciosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Crear Pedido</PageTitle>

<EditForm Model="Pedido" OnValidSubmit="Guardar" FormName="crearPedido" Context="formContext">
    <DataAnnotationsValidator />

    <div class="container arthea-pedidos-create">
        <div class="card shadow-lg">

            @* Encabezado *@
            <div class="card-header">
                <h5 class="card-title">Crear Pedido</h5>
            </div>

            <div class="card-body">

                @* PedidoId *@
                <div class="mb-3">
                    <label class="form-label"><strong>PedidoId</strong></label>
                    <InputNumber class="form-control" @bind-Value="Pedido.PedidoId" readonly />
                </div>

                @* Cliente *@
                <div class="mb-3">
                    <label class="form-label"><strong>Cliente</strong></label>
                    <InputSelect class="form-select" @bind-Value="Pedido.ClienteId">
                        <option value="0">-- Seleccione un cliente --</option>
                        @foreach (var cliente in ListaClientes)
                        {
                            <option value="@cliente.ClienteId">@cliente.Usuario?.Nombres @cliente.Usuario?.Apellidos</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Pedido.ClienteId)" />
                </div>

                @* Fecha *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <InputDate class="form-control" @bind-Value="Pedido.Fecha" />
                    <ValidationMessage For="@(() => Pedido.Fecha)" />
                </div>

                @* Total *@
                <div class="mb-3">
                    <label class="form-label"><strong>Total</strong></label>
                    <InputNumber class="form-control" @bind-Value="Pedido.Total" readonly />
                </div>

                @* Picker para el detalle *@
                <div class="detalle-servicios border p-3 mt-3">
                    <h5>Detalles</h5>

                    <div class="input-group">
                        <span class="input-group-text">Seleccione:</span>

                        <InputSelect class="form-select" @bind-Value="ServicioId">
                            <option value="0">-- Seleccione un servicio --</option>
                            @foreach (var servicio in ListaServicios)
                            {
                                <option value="@servicio.ServicioId">@servicio.Nombre</option>
                            }
                        </InputSelect>

                        <span class="input-group-text">Precio:</span>
                        <label class="form-control">@(ListaServicios.FirstOrDefault(s => s.ServicioId == ServicioId)?.Precio.ToString("N2") ?? "0.00")</label>

                        <button type="button" class="btn btn-outline-primary" @onclick="AgregarServicio">+ Agregar</button>
                    </div>

                    @* Tabla para el detalle *@
                    <hr />

                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Servicio</th>
                                <th>Artista</th>
                                <th>Modalidad</th>
                                <th>Precio</th>
                                <th>Opciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in Pedido.PedidosDetalle)
                            {
                                var servicio = ListaServicios.FirstOrDefault(s => s.ServicioId == detalle.ServicioId) ?? detalle.Servicio;

                                <tr @key="detalle">
                                    <td>@servicio?.Nombre</td>
                                    <td>@servicio?.Artista?.Usuario?.Nombres @servicio?.Artista?.Usuario?.Apellidos</td>
                                    <td>@detalle.ModalidadEntrega</td>
                                    <td>@detalle.Precio.ToString("N2")</td>
                                    <td>
                                        <button type="button" class="btn btn-outline-primary bi bi-pencil-square me-2" title="Modificar solicitud" @onclick="() => VerDetalle(detalle)"></button>
                                        <button type="button" class="btn btn-danger bi bi-trash" title="Remover servicio" @onclick="() => QuitarServicio(detalle)"></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* Footer *@
            <div class="card-footer text-center mt-2">
                <a href="/Pedidos/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>

        </div>
    </div>
</EditForm>

@* Modal para solicitar servicios *@
<SolicitarServicioModal Detalle="DetalleSeleccionado" Servicio="ServicioSeleccionado" Editando="EditandoDetalle" OnConfirmar="ConfirmarServicio" OnCancelar="CerrarModal" />

@code {
    public Pedidos Pedido { get; set; } = new();
    public List<Clientes> ListaClientes { get; set; } = new();
    public List<Servicios> ListaServicios { get; set; } = new();

    public int ServicioId { get; set; }
    public PedidosDetalle? DetalleSeleccionado { get; set; }
    public Servicios? ServicioSeleccionado { get; set; }
    public bool EditandoDetalle { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var clientes = await clientesService.GetList(c => c.ClienteId > 0);
        ListaClientes = clientes.Value ?? new();

        var servicios = await serviciosService.GetList(s => s.Estado);
        ListaServicios = servicios.Value ?? new();
    }

    private void AgregarServicio()
    {
        var servicio = ListaServicios.FirstOrDefault(s => s.ServicioId == ServicioId);

        if (servicio is null)
        {
            toastService.ShowError("Seleccione un servicio válido");
            return;
        }

        if (Pedido.PedidosDetalle.Any(d => d.ServicioId == ServicioId))
        {
            toastService.ShowError("Este servicio ya fue agregado");
            return;
        }

        ServicioSeleccionado = servicio;
        EditandoDetalle = false;

        DetalleSeleccionado = new PedidosDetalle
        {
            ServicioId = servicio.ServicioId,
            Cantidad = 1,
            Precio = Convert.ToDouble(servicio.Precio),
            GuiaRequerimientos = servicio.GuiaRequerimientos,
            ModalidadEntrega = servicio.ModalidadEntrega
        };
    }

    private void VerDetalle(PedidosDetalle detalle)
    {
        ServicioSeleccionado = ListaServicios.FirstOrDefault(s => s.ServicioId == detalle.ServicioId) ?? detalle.Servicio;
        EditandoDetalle = true;

        DetalleSeleccionado = new PedidosDetalle
        {
            ServicioId = detalle.ServicioId,
            Cantidad = detalle.Cantidad,
            Precio = detalle.Precio,
            GuiaRequerimientos = detalle.GuiaRequerimientos,
            ModalidadEntrega = detalle.ModalidadEntrega,
            Requerimientos = detalle.Requerimientos,
            EnlaceReferencia = detalle.EnlaceReferencia,
            DireccionEntrega = detalle.DireccionEntrega,
            MedioEntrega = detalle.MedioEntrega,
            ContactoEntrega = detalle.ContactoEntrega,
            Referencias = detalle.Referencias.Select(r => new PedidosReferencias { Imagen = r.Imagen }).ToList()
        };
    }

    private void ConfirmarServicio(PedidosDetalle detalleSeleccionado)
    {
        if (EditandoDetalle)
        {
            var detalle = Pedido.PedidosDetalle.FirstOrDefault(d => d.ServicioId == detalleSeleccionado.ServicioId);

            if (detalle is not null)
            {
                detalle.Requerimientos = detalleSeleccionado.Requerimientos;
                detalle.EnlaceReferencia = detalleSeleccionado.EnlaceReferencia;
                detalle.DireccionEntrega = detalleSeleccionado.DireccionEntrega;
                detalle.MedioEntrega = detalleSeleccionado.MedioEntrega;
                detalle.ContactoEntrega = detalleSeleccionado.ContactoEntrega;
                detalle.Referencias = detalleSeleccionado.Referencias;
            }
        }
        else
        {
            Pedido.PedidosDetalle.Add(detalleSeleccionado);
        }

        CalcularTotal();
        ServicioId = 0;
        CerrarModal();
    }

    private void CerrarModal()
    {
        DetalleSeleccionado = null;
        ServicioSeleccionado = null;
        EditandoDetalle = false;
    }

    private void QuitarServicio(PedidosDetalle detalle)
    {
        Pedido.PedidosDetalle.Remove(detalle);
        CalcularTotal();
    }

    private void CalcularTotal()
    {
        Pedido.Total = Pedido.PedidosDetalle.Sum(d => d.Subtotal);
    }

    private async Task Guardar()
    {
        if (Pedido.PedidosDetalle.Count == 0)
        {
            toastService.ShowError("Debe agregar al menos un servicio");
            return;
        }

        if (Pedido.PedidosDetalle.Any(d => string.IsNullOrWhiteSpace(d.Requerimientos)))
        {
            toastService.ShowError("Debe completar los requerimientos de todos los servicios");
            return;
        }

        CalcularTotal();

        var resultado = await pedidosService.Guardar(Pedido);
        bool guardado = false;

        resultado.OnSuccess(() => { guardado = true; });
        resultado.OnFailure(() => { guardado = false; });

        if (!guardado)
        {
            toastService.ShowError("No se ha podido guardar el pedido");
            return;
        }

        toastService.ShowSuccess("Pedido guardado correctamente");
        navigationManager.NavigateTo("/Pedidos/Index");
    }
}
