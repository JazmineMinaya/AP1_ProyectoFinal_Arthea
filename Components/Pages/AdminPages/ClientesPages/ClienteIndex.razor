@page "/Clientes/Index"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]

@inject ClientesService clientesService
@inject ToastService toastService

<PageTitle>Clientes</PageTitle>

<div class="container arthea-cliente-index">
    <div class="card shadow-lg">

        @* Encabezado *@
        <div class="card-header d-flex justify-content-between align-content-center">
            <h5 class="card-title">Registro de Clientes</h5>
            <a href="/Clientes/Create" class="btn btn-primary"><span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">

            @* Labels *@
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>Búsqueda</strong></label>
                </div>
            </div>

            @* Filtros *@
            <div class="row align-items-end">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" disabled>Elija una opción</option>
                        <option value="ClienteId">ClienteId</option>
                        <option value="Nombres">Nombres</option>
                        <option value="Correo">Correo</option>
                        <option value="Telefono">Teléfono</option>
                    </InputSelect>
                </div>

                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>

                <div class="col-2">
                    <button type="button" class="btn btn-outline-secondary bi bi-arrow-counterclockwise" @onclick="Reestablecer"></button>
                </div>

                @* QuickGrid *@
                <div class="grid">
                    <QuickGrid Items="ListaClientes.AsQueryable()" Class="table table-hover mt-3">
                        <PropertyColumn Property="c => c.ClienteId" Title="ClienteId" Sortable="true" />

                        <TemplateColumn Title="Nombres" Sortable="true" SortBy="GridSort<Clientes>.ByAscending(c => c.Usuario!.Nombres)">
                            @($"{context.Usuario?.Nombres} {context.Usuario?.Apellidos}")
                        </TemplateColumn>

                        <PropertyColumn Property="c => c.Usuario!.Email" Title="Correo" Sortable="true" />
                        <PropertyColumn Property="c => c.Telefono" Title="Teléfono" Sortable="true" />
                        <PropertyColumn Property="c => c.Direccion" Title="Dirección" Sortable="true" />

                        <TemplateColumn Title="Estado" Sortable="true" SortBy="GridSort<Clientes>.ByAscending(c => c.Usuario!.Estado)">
                            @(context.Usuario?.Estado == true ? "Activo" : "Inactivo")
                        </TemplateColumn>

                        <TemplateColumn Title="Opciones" Align="Align.Center">
                            <a href="/Clientes/Edit/@context.ClienteId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                        </TemplateColumn>
                    </QuickGrid>
                </div>

            </div>
        </div>

        @* Footer *@
        <div class="card-footer d-flex justify-content-between align-items-center">
            <label><strong>Cantidad: </strong> @ListaClientes.Count()</label>
        </div>

    </div>
</div>

@code {
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    public List<Clientes> ListaClientes { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await Reestablecer();
    }

    private async Task Buscar()
    {
        var resultado = await clientesService.GetList(c => c.ClienteId > 0);

        var lista = resultado.Value ?? new();

        if (!string.IsNullOrWhiteSpace(Filtro) && !string.IsNullOrWhiteSpace(ValorFiltro))
        {
            var valor = ValorFiltro.Trim().ToLower();

            lista = Filtro switch
            {
                "ClienteId" => lista.Where(c => c.ClienteId.ToString() == valor).ToList(),
                "Nombres" => lista.Where(c => c.Usuario != null && $"{c.Usuario.Nombres} {c.Usuario.Apellidos}".ToLower().Contains(valor)).ToList(),
                "Correo" => lista.Where(c => c.Usuario?.Email != null && c.Usuario.Email.ToLower().Contains(valor)).ToList(),
                "Telefono" => lista.Where(c => c.Telefono.ToLower().Contains(valor)).ToList(),
                _ => lista
            };
        }
        else if (string.IsNullOrWhiteSpace(Filtro) && !string.IsNullOrWhiteSpace(ValorFiltro))
        {
            toastService.ShowError("Seleccione un filtro");
            return;
        }

        ListaClientes = lista;
    }

    private async Task Reestablecer()
    {
        var resultado = await clientesService.GetList(c => c.ClienteId > 0);
        ListaClientes = resultado.Value ?? new();

        Filtro = string.Empty;
        ValorFiltro = string.Empty;
    }
}
