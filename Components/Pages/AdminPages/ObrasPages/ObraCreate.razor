@page "/Obras/Create"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]

@inject ObrasService obrasService
@inject ArtistasService artistasService
@inject NavigationManager navigationManager
@inject ToastService toastService
@inject IWebHostEnvironment environment

<PageTitle>Crear Obra</PageTitle>

<EditForm Model="Obra" OnValidSubmit="Guardar" FormName="crearObra">
    <DataAnnotationsValidator />

    <div class="container arthea-obra-create">
        <div class="card shadow-lg">

            <div class="card-header">
                <h5 class="card-title">Crear Obra</h5>
            </div>

            <div class="card-body">

                @* Imagen de la Obra *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fotografía de la Obra</strong></label>
                    <div>
                        <label for="imagen" class="cuadro-imagen">
                            @if (string.IsNullOrEmpty(imagenPreview))
                            {
                                <i class="bi bi-plus-lg"></i>
                            }
                            else
                            {
                                <img src="@imagenPreview" alt="Imagen de obra" />
                            }
                        </label>
                        <InputFile id="imagen" class="d-none" accept=".jpg,.jpeg,.png" OnChange="SeleccionarImagen" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>ObraId</strong></label>
                    <InputNumber class="form-control" @bind-Value="Obra.ObraId" readonly />
                </div>

                @* Artista *@
                <div class="mb-3">
                    <label class="form-label"><strong>Artista</strong></label>
                    <InputSelect class="form-select" @bind-Value="Obra.ArtistaId">
                        <option value="0">Seleccione un artista</option>
                        @foreach (var artista in ListaArtistas)
                        {
                            <option value="@artista.ArtistaId">@($"{artista.Usuario?.Nombres} {artista.Usuario?.Apellidos} ({artista.Disciplina})")</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Obra.ArtistaId)" />
                </div>

                @* Título *@
                <div class="mb-3">
                    <label class="form-label"><strong>Título</strong></label>
                    <InputText class="form-control" @bind-Value="Obra.Titulo" placeholder="Título de la obra" />
                    <ValidationMessage For="@(() => Obra.Titulo)" />
                </div>

                @* Categoría *@
                <div class="mb-3">
                    <label class="form-label"><strong>Categoría / Técnica</strong></label>
                    <InputSelect class="form-select" @bind-Value="Obra.Categoria">
                        <option value="">Seleccione una categoría</option>
                        <option value="Óleo sobre lienzo">Óleo sobre lienzo</option>
                        <option value="Acrílico">Acrílico</option>
                        <option value="Acuarela">Acuarela</option>
                        <option value="Carboncillo">Carboncillo</option>
                        <option value="Escultura">Escultura</option>
                        <option value="Fotografía">Fotografía</option>
                        <option value="Ilustración Digital">Ilustración Digital</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => Obra.Categoria)" />
                </div>

                @* Precio *@
                <div class="mb-3">
                    <label class="form-label"><strong>Precio</strong></label>
                    <InputNumber class="form-control" @bind-Value="Obra.Precio" />
                    <ValidationMessage For="@(() => Obra.Precio)" />
                </div>

                @* Descripción *@
                <div class="mb-3">
                    <label class="form-label"><strong>Descripción</strong></label>
                    <InputTextArea class="form-control" @bind-Value="Obra.Descripcion" rows="4" placeholder="Describa la técnica, dimensiones e inspiración de la obra" />
                    <ValidationMessage For="@(() => Obra.Descripcion)" />
                </div>

                @* Fecha de Publicación *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Publicación</strong></label>
                    <InputDate class="form-control" @bind-Value="Obra.FechaPublicacion" readonly />
                </div>

                @* Estado *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estado</strong></label>
                    <InputSelect class="form-select" @bind-Value="Obra.Estado">
                        <option value="Disponible">Disponible</option>
                        <option value="Reservada">Reservada</option>
                        <option value="Vendida">Vendida</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => Obra.Estado)" />
                </div>

            </div>

            <div class="card-footer text-center mt-2">
                <a href="/Obras/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>

        </div>
    </div>
</EditForm>

@code {
    public Obras Obra = new Obras();
    public List<Artistas> ListaArtistas = new();

    private IBrowserFile? imagenSeleccionada;
    private string? imagenPreview;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await artistasService.GetList(a => a.Usuario != null && a.Usuario.Estado);
        ListaArtistas = resultado.Value ?? new();
    }

    private async Task SeleccionarImagen(InputFileChangeEventArgs archivoSeleccionado)
    {
        var imagen = archivoSeleccionado.File;
        var formatos = new[] { "image/jpeg", "image/png" };

        if (!formatos.Contains(imagen.ContentType.ToLowerInvariant()))
        {
            toastService.ShowError("Solo se permiten fotografías JPG, JPEG y PNG");
            return;
        }

        if (imagen.Size > 5 * 1024 * 1024)
        {
            toastService.ShowError("La fotografía no puede superar los 5 MB");
            return;
        }

        imagenSeleccionada = imagen;
        using var memoria = new MemoryStream();
        await imagen.OpenReadStream(5 * 1024 * 1024).CopyToAsync(memoria);
        imagenPreview = $"data:{imagen.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}";
    }

    private async Task GuardarFotografia()
    {
        if (imagenSeleccionada is null) return;

        var carpeta = Path.Combine(environment.WebRootPath, "imagenes", "obras");
        Directory.CreateDirectory(carpeta);

        var extension = imagenSeleccionada.ContentType.ToLowerInvariant() switch
        {
            "image/jpeg" => ".jpg",
            "image/png" => ".png",
            _ => throw new InvalidOperationException("Formato no permitido")
        };

        var nombreArchivo = $"{Guid.NewGuid():N}{extension}";
        var rutaArchivo = Path.Combine(carpeta, nombreArchivo);

        await using var archivo = new FileStream(rutaArchivo, FileMode.CreateNew);
        await imagenSeleccionada.OpenReadStream(5 * 1024 * 1024).CopyToAsync(archivo);

        Obra.ImagenUrl = $"/imagenes/obras/{nombreArchivo}";
    }

    private async Task Guardar()
    {
        try
        {
            await GuardarFotografia();
            var resultado = await obrasService.Guardar(Obra);

            resultado.OnSuccess(() =>
            {
                toastService.ShowSuccess("Obra guardada correctamente");
                navigationManager.NavigateTo("/Obras/Index");
            });

            resultado.OnFailure(() => toastService.ShowError("No se ha podido guardar la obra"));
        }
        catch
        {
            toastService.ShowError("No se ha podido guardar la obra");
        }
    }
}