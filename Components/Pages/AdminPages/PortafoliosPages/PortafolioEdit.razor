@page "/Portafolios/Edit/{PortafolioId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]

@inject PortafoliosService portafoliosService
@inject ArtistasService artistasService
@inject ObrasService obrasService
@inject NavigationManager navigationManager
@inject ToastService toastService
@inject IWebHostEnvironment environment

<PageTitle>Modificar Portafolio</PageTitle>

<EditForm Model="Portafolio" OnValidSubmit="Modificar" FormName="editarPortafolio" Context="formContext">
    <DataAnnotationsValidator />

    <div class="container arthea-portafolio-edit">
        <div class="card shadow-lg">

            @* Encabezado *@
            <div class="card-header">
                <h5 class="card-title">Modificar Portafolio</h5>
            </div>

            <div class="card-body">

                @* Imagen de Portada *@
                <div class="mb-3">
                    <label class="form-label"><strong>Imagen de Portada</strong></label>
                    <div>
                        <label for="imagen" class="cuadro-imagen">
                            @if (string.IsNullOrEmpty(imagenPreview))
                            {
                                <i class="bi bi-plus-lg"></i>
                            }
                            else
                            {
                                <img src="@imagenPreview" alt="Portada" />
                            }
                        </label>
                        <InputFile id="imagen" class="d-none" accept=".jpg,.jpeg,.png" OnChange="SeleccionarImagen" />
                    </div>
                </div>

                @* PortafolioId *@
                <div class="mb-3">
                    <label class="form-label"><strong>PortafolioId</strong></label>
                    <InputNumber class="form-control" @bind-Value="Portafolio.PortafolioId" readonly />
                </div>

                @* Fecha de Creación *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Creación</strong></label>
                    <InputDate class="form-control" @bind-Value="Portafolio.FechaCreacion" readonly />
                </div>

                @* Artista *@
                <div class="mb-3">
                    <label class="form-label"><strong>Artista</strong></label>
                    <InputSelect class="form-select" @bind-Value="Portafolio.ArtistaId" disabled>
                        <option value="0">-- Seleccione un artista --</option>
                        @foreach (var artista in ListaArtistas)
                        {
                            <option value="@artista.ArtistaId">@($"{artista.Usuario?.Nombres} {artista.Usuario?.Apellidos} ({artista.Disciplina})")</option>
                        }
                    </InputSelect>
                </div>

                @* Título *@
                <div class="mb-3">
                    <label class="form-label"><strong>Título del Portafolio</strong></label>
                    <InputText class="form-control" @bind-Value="Portafolio.Titulo" />
                    <ValidationMessage For="@(() => Portafolio.Titulo)" />
                </div>

                @* Descripción *@
                <div class="mb-3">
                    <label class="form-label"><strong>Descripción</strong></label>
                    <InputTextArea class="form-control" @bind-Value="Portafolio.Descripcion" rows="3" />
                    <ValidationMessage For="@(() => Portafolio.Descripcion)" />
                </div>

                @* Detalles *@
                <div class="detalle-box mt-4">
                    <h5 class="detalle-titulo">Detalle de Obras del Portafolio</h5>

                    <div class="input-group">
                        <span class="input-group-text">Seleccione:</span>

                        <InputSelect class="form-select" @bind-Value="DetalleActual.ObraId">
                            <option value="0">-- Seleccione una obra --</option>
                            @foreach (var obra in ObrasDisponibles)
                            {
                                <option value="@obra.ObraId">@obra.Titulo</option>
                            }
                        </InputSelect>

                        <button type="button" class="btn btn-agregar" @onclick="AgregarDetalle">
                            <span class="bi bi-plus"></span> Agregar
                        </button>
                    </div>

                    <hr class="detalle-separador" />

                    <table class="table table-hover tabla-detalle">
                        <thead>
                            <tr>
                                <th>Obra</th>
                                <th>Título</th>
                                <th>Categoría</th>
                                <th>Técnica</th>
                                <th class="text-center">Remover</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Portafolio.PortafoliosDetalle.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">No se han agregado obras a este portafolio.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Portafolio.PortafoliosDetalle)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.Obra?.ImagenUrl))
                                            {
                                                <img src="@item.Obra.ImagenUrl" alt="@item.Obra.Titulo" class="imagen-obra-detalle" />
                                            }
                                            else
                                            {
                                                <span>Sin imagen</span>
                                            }
                                        </td>
                                        <td>@item.Obra?.Titulo</td>
                                        <td>@item.Obra?.Categoria</td>
                                        <td>@item.Obra?.Tecnica</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-danger bi bi-trash" @onclick="() => EliminarDetalle(item)"></button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </div>

            @* Footer *@
            <div class="card-footer text-center mt-2">
                <a href="/Portafolios/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#eliminarModal"> Eliminar</button>
            </div>

        </div>
    </div>
</EditForm>

@* Modal de confirmación de eliminación *@
<div class="modal fade" id="eliminarModal" tabindex="-1" aria-labelledby="eliminarModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="eliminarModalLabel">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro que desea eliminar este portafolio?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cancelar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar"> Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int PortafolioId { get; set; }

    public Portafolios Portafolio { get; set; } = new();
    public PortafoliosDetalle DetalleActual { get; set; } = new();

    public List<Artistas> ListaArtistas { get; set; } = new();
    public List<Obras> ObrasDisponibles { get; set; } = new();

    private IBrowserFile? imagenSeleccionada;
    private string? imagenPreview;

    protected override async Task OnInitializedAsync()
    {
        var artistas = await artistasService.GetList(a => a.ArtistaId > 0);
        ListaArtistas = artistas.Value ?? new();

        var resultado = await portafoliosService.Buscar(PortafolioId);

        if (resultado.Value is null)
        {
            toastService.ShowError("Portafolio no encontrado");
            navigationManager.NavigateTo("/Portafolios/Index");
            return;
        }

        Portafolio = resultado.Value;

        imagenPreview = !string.IsNullOrWhiteSpace(Portafolio.ImagenPortada)
            && Portafolio.ImagenPortada.StartsWith("/imagenes/portafolios/") ? Portafolio.ImagenPortada : null;

        var obras = await obrasService.GetList(o => o.ArtistaId == Portafolio.ArtistaId);
        ObrasDisponibles = obras.Value ?? new();
    }

    private void AgregarDetalle()
    {
        var obra = ObrasDisponibles.FirstOrDefault(o => o.ObraId == DetalleActual.ObraId && o.ArtistaId == Portafolio.ArtistaId);

        if (obra == null)
        {
            toastService.ShowError("Seleccione una obra válida");
            return;
        }

        if (Portafolio.PortafoliosDetalle.Any(d => d.ObraId == DetalleActual.ObraId))
        {
            toastService.ShowError("Esta obra ya fue agregada");
            return;
        }

        Portafolio.PortafoliosDetalle.Add(new PortafoliosDetalle
        {
            PortafolioId = Portafolio.PortafolioId,
            ObraId = DetalleActual.ObraId,
            Obra = obra
        });

        DetalleActual = new();
    }

    private void EliminarDetalle(PortafoliosDetalle detalle)
    {
        Portafolio.PortafoliosDetalle.Remove(detalle);
    }

    private async Task SeleccionarImagen(InputFileChangeEventArgs archivoSeleccionado)
    {
        var imagen = archivoSeleccionado.File;
        var formatos = new[] { "image/jpeg", "image/png" };

        if (!formatos.Contains(imagen.ContentType.ToLowerInvariant()))
        {
            toastService.ShowError("Solo se permiten fotografías JPG, JPEG y PNG");
            return;
        }

        if (imagen.Size > 5 * 1024 * 1024)
        {
            toastService.ShowError("La fotografía no puede superar los 5 MB");
            return;
        }

        imagenSeleccionada = imagen;
        using var memoria = new MemoryStream();
        await imagen.OpenReadStream(5 * 1024 * 1024).CopyToAsync(memoria);
        imagenPreview = $"data:{imagen.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}";
    }

    private async Task GuardarPortada()
    {
        if (imagenSeleccionada is null) return;

        var carpeta = Path.Combine(environment.WebRootPath, "imagenes", "portafolios");
        Directory.CreateDirectory(carpeta);

        var extension = imagenSeleccionada.ContentType.ToLowerInvariant() switch
        {
            "image/jpeg" => ".jpg",
            "image/png" => ".png",
            _ => throw new InvalidOperationException("Formato no permitido")
        };

        var nombreArchivo = $"{Guid.NewGuid():N}{extension}";
        var rutaArchivo = Path.Combine(carpeta, nombreArchivo);

        await using var archivo = new FileStream(rutaArchivo, FileMode.CreateNew);
        await imagenSeleccionada.OpenReadStream(5 * 1024 * 1024).CopyToAsync(archivo);

        Portafolio.ImagenPortada = $"/imagenes/portafolios/{nombreArchivo}";
    }

    private async Task Modificar()
    {
        if (Portafolio.PortafoliosDetalle.Count == 0)
        {
            toastService.ShowError("Debe agregar al menos una obra al portafolio");
            return;
        }

        try
        {
            await GuardarPortada();
            var resultado = await portafoliosService.Guardar(Portafolio);
            bool guardado = false;

            resultado.OnSuccess(() =>
            {
                guardado = true;
            });

            resultado.OnFailure(() =>
            {
                guardado = false;
            });

            if (!guardado)
            {
                toastService.ShowError("No se ha podido modificar el portafolio");
                return;
            }

            toastService.ShowSuccess("Portafolio modificado correctamente");
            navigationManager.NavigateTo("/Portafolios/Index");
        }
        catch
        {
            toastService.ShowError("No se ha podido modificar el portafolio");
        }
    }

    private async Task Eliminar()
    {
        var resultado = await portafoliosService.Eliminar(Portafolio.PortafolioId);
        bool eliminado = false;

        resultado.OnSuccess(() =>
        {
            eliminado = true;
        });

        resultado.OnFailure(() =>
        {
            eliminado = false;
        });

        if (!eliminado)
        {
            toastService.ShowError("No se ha podido eliminar el portafolio");
            return;
        }

        toastService.ShowSuccess("Portafolio eliminado correctamente");
        navigationManager.NavigateTo("/Portafolios/Index");
    }
}
